# Tokens e dados de clientes nunca vão para o repositório
busca-de-dados/.env
busca-de-dados/clientes.json
busca-de-dados/saida/

# Servidor (Go): configuração local com segredos
servidor/.env

# Cópias do painel embutidas no servidor na construção da imagem (a fonte é o index.html da raiz)
servidor/api/web/painel/index.html
