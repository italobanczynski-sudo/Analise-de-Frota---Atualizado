# Copie este arquivo para api/.env e cole o token de cada cliente depois do "=".
# O api/.env fica fora do Git (.gitignore): nunca faça commit dele nem cole o token em chat.
# O nome da variável é o que aparece em "token" no api/clientes.json.
GOBRAX_TOKEN_CLIENTE1=
GOBRAX_TOKEN_CLIENTE2=

# Token do app privado do HubSpot (Configurações → Integrações → Apps privados), só leitura.
# Usado por: node api/hubspot.mjs
HUBSPOT_TOKEN=
