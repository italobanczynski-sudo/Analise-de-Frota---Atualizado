# Copie para .env (fica só neste computador, fora do Git) e preencha.

# Plataforma
SERVIDOR_URL=https://analise-de-frota.onrender.com
# Usuário próprio do robô, com papel COLABORADOR (crie em Configurações › Usuários)
ROBO_EMAIL=
ROBO_SENHA=

# Chrome deste computador (o WhatsApp Web roda nele, sem janela)
CHROME=C:/Program Files/Google/Chrome/Application/chrome.exe

# Pausa sorteada entre uma mensagem e outra, em segundos (menos pausa = mais risco de bloqueio)
PAUSA_MIN_SEG=25
PAUSA_MAX_SEG=60
# Se os dados de ontem ainda não chegaram às 08:00, confere de novo a cada ESPERA_DADOS_MIN até LIMITE_HORA
ESPERA_DADOS_MIN=20
LIMITE_HORA=12
MAX_POR_DIA=200
# Só estes clientes (nomes separados por vírgula); vazio = todos
CLIENTES=
