# Copie para .env (que fica fora do Git) e preencha. Nunca coloque valores reais neste arquivo.

# Senha do Postgres local do docker-compose
POSTGRES_PASSWORD=<senha-do-banco-local>

# Chave que cifra os tokens dos clientes no banco: 32 bytes em base64 (openssl rand -base64 32)
# Se trocar a chave, os tokens já salvos precisam ser salvos de novo.
CHAVE_TOKENS=<chave-base64-de-32-bytes>

# URL pública da plataforma (vira o começo dos links de convite e define modo HTTPS do cookie)
URL_PUBLICA=https://analisefrota.gobrax.com.br
ORIGENS_PERMITIDAS=https://analisefrota.gobrax.com.br

# ── Email (Gmail com Senha de app) ──────────────────────────────────────────
# Gere a senha em: myaccount.google.com > Segurança > Senhas de app
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=587
SMTP_USUARIO=<seu-email@gmail.com>
SMTP_SENHA=<senha-de-app-de-16-caracteres>
SMTP_REMETENTE=<seu-email@gmail.com>

# Opcionais (valores padrão)
# PORTA=8080
# SESSAO_HORAS=12
# CONVITE_HORAS=72
# COLETA_AUTOMATICA=true
# COLETA_INTERVALO_MIN=60
# COLETA_DIAS=30
# GOBRAX_API_BASE=https://gateway-v3.gobrax.com.br:8889/api/
# GOBRAX_INTERVALO_MS=120
